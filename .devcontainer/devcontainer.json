{
  "name": "mise",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers-extra/features/mise:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": ["hverlin.mise-vscode"]
    }
  },
  "mounts": [
    {
      "source": "mise-data-volume",
      "target": "/mnt/mise-data",
      "type": "volume"
    },
    {
      "source": "nvim-plugins-volume",
      "target": "/home/vscode/.local/share/nvim",
      "type": "volume"
    },
    {
      "source": "nvim-state-volume",
      "target": "/home/vscode/.local/state/nvim",
      "type": "volume"
    },
    {
      "source": "${localWorkspaceFolder}/mise.nvim.toml",
      "target": "/home/vscode/.config/mise/conf.d/mise.nvim.toml",
      "type": "bind"
    }
  ],
  "containerEnv": {
    "MISE_DATA_DIR": "/mnt/mise-data"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/mnt/mise-data/shims"
  },
  "postCreateCommand": "sudo chown -R vscode:vscode /mnt/mise-data && sudo chown -R vscode:vscode ~/ && mise trust && mise i"
}
